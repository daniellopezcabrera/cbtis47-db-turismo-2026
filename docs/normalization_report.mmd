erDiagram
    USER ||--o{ FLIGHT_BOOKING : makes
    USER ||--o{ TROLLEY_BOOKING : makes

    USER {
        int id_user PK
        string email
        string user_name
        string password
    }

    PERSON ||--|| USER : register

    PERSON {
        int id_user PK, FK
        string name
        string last_names
        varchar curp
        string birth_date
    }

    %% AIRPORT replaces LOCATION
    AIRPORT ||--o{ FLIGHT : origin
    AIRPORT ||--o{ FLIGHT : destination

    AIRPORT {
        int id_airport PK
        varchar city_name
        varchar airport_name
        varchar airport_code
    }

    FLIGHT {
        int id_flight PK
        varchar flight_number
        varchar flight_name
        int origin_airport_id FK
        int dest_airport_id FK
        date flight_date
        time departure_time
        time arrival_time
        decimal base_price
        enum status
    }

    FLIGHT ||--o{ FLIGHT_BOOKING : booked_in

    FLIGHT_BOOKING {
        int id_booking PK
        int id_user FK
        int id_flight FK
        datetime booking_date
        enum status
    }

    %% Tickets now linked to flight booking
    FLIGHT_BOOKING ||--|{ TICKET : generates

    TICKET {
        int id_ticket PK
        int id_booking FK
        string qr_code
    }

    %% -------- TROLLEY SYSTEM --------

    TROLLEY ||--o{ TROLLEY_TRIP : assigned_to

    TROLLEY {
        int id_trolley PK
        string plate_number
        int id_model FK
    }

    ROUTE ||--|{ ROUTE_STOP : contains
    ROUTE ||--o{ TROLLEY_ROUTE_SCHEDULE : has

    ROUTE {
        int id_route PK
        string route_name
    }

    TROLLEY_STOP ||--o{ ROUTE_STOP : location

    TROLLEY_STOP {
        int id_stop PK
        string name
        string coordinates
    }

    ROUTE_STOP {
        int id_route_stop PK
        int id_route FK
        int id_stop FK
        int stop_order
    }

    %% New schedule tables
    TROLLEY_ROUTE_SCHEDULE ||--o{ SCHEDULE_DAY : occurs_on
    TROLLEY_ROUTE_SCHEDULE ||--o{ TROLLEY_TRIP : generates

    TROLLEY_ROUTE_SCHEDULE {
        int id_route_schedule PK
        int id_route FK
        time departure_time
        time arrival_time
    }

    SCHEDULE_DAY {
        int id_schedule_day PK
        int id_route_schedule FK
        enum day_of_week
    }

    TROLLEY_TRIP ||--o{ TROLLEY_BOOKING : reserved_in

    TROLLEY_TRIP {
        int id_trip PK
        int id_route_schedule FK
        int id_trolley FK
        date trip_date
        enum status
    }

    TROLLEY_BOOKING {
        int id_booking PK
        int id_user FK
        int id_trip FK
        int boarding_stop_id FK
        int alighting_stop_id FK
        datetime booking_date
        enum status
    }
